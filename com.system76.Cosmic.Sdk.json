{
    "build-runtime": true,
    "id": "com.system76.Cosmic.Sdk",
    "id-platform": "com.system76.Cosmic.Platform",
    "branch": "master",
    "runtime": "org.freedesktop.Platform",
    "sdk": "org.freedesktop.Sdk",
    "runtime-version": "25.08",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Debug",
        "org.freedesktop.Sdk.Locale",
        "org.freedesktop.Sdk.Docs"
    ],
    "platform-extensions": [
        "org.freedesktop.Platform.Locale"
    ],
    "inherit-extensions": [
        "org.freedesktop.Platform.GL",
        "org.freedesktop.Platform.Timezones",
        "org.freedesktop.Platform.Icontheme",
        "org.freedesktop.Platform.VulkanLayer"
    ],
    "inherit-sdk-extensions": [
        "org.freedesktop.Sdk.Extension"
    ],
    "finish-args": [
        "--talk-name=com.system76.CosmicSettingsDaemon",
        "--filesystem=xdg-config/cosmic:ro",
        "--runtime=com.system76.Cosmic.Platform//master",
        "--sdk=com.system76.Cosmic.Sdk//master"
    ],
    "modules": [
        {
            "name": "just",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm0755 just /usr/bin/just"
            ],
            "sources": [
                {
                    "type": "archive",
                    "strip-components": 0,
                    "dest-filename": "just.tar.gz",
                    "url": "https://github.com/casey/just/releases/download/1.49.0/just-1.49.0-x86_64-unknown-linux-musl.tar.gz",
                    "sha256": "05eb2f068b641b06e5b318796c2e27d4dcca608e65b34329a08c1b9f582611bd",
                    "only_arches": [
                        "x86_64"
                    ]
                },
                {
                    "type": "archive",
                    "strip-components": 0,
                    "dest-filename": "just.tar.gz",
                    "url": "https://github.com/casey/just/releases/download/1.49.0/just-1.49.0-aarch64-unknown-linux-musl.tar.gz",
                    "sha256": "993b78f51004248114af22368f69715541542b3c9941c80e02f8ae10eb404ae0",
                    "only_arches": [
                        "aarch64"
                    ]
                }
            ]
        },
        {
            "name": "pop-icon-theme",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/pop-os/icon-theme.git",
                    "tag": "v3.5.1"
                }
            ]
        },
        {
            "name": "cosmic-icons",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/pop-os/cosmic-icons.git",
                    "tag": "epoch-1.0.9"
                }
            ],
            "build-commands": [
                "just install"
            ]
        }
    ]
}
